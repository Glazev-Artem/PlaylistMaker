<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="61dp"
    android:orientation="horizontal"
    android:paddingHorizontal="13dp"
    android:paddingVertical="8dp"
    android:background="?attr/selectableItemBackground">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/playlist_item_cover"
        android:layout_width="45dp"
        android:layout_height="45dp"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        app:shapeAppearanceOverlay="@style/RoundedCorners2" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_gravity="center_vertical"
        android:layout_weight="1"
        android:orientation="vertical">
        <TextView
            android:id="@+id/playlist_item_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/ys_display_regular"
            android:textSize="16sp"
            android:includeFontPadding="false"
            android:letterSpacing="0"
            android:textColor="@color/playlist_sheet_name"
            android:maxLines="1"
            android:ellipsize="end" />
        <TextView
            android:id="@+id/playlist_item_count"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:fontFamily="@font/ys_display_regular"
            android:textSize="11sp"
            android:includeFontPadding="false"
            android:letterSpacing="0"
            android:textColor="?attr/settingsIconTint" />
    </LinearLayout>
</LinearLayout>
